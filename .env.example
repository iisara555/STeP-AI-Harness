# STeP AI local browser settings — copy to .env only when needed.
# .env is gitignored. Do NOT put passwords, tokens, MFA codes, cookies, or recovery codes here.

STEP_BROWSER_REMEMBER_LOGIN=false
STEP_BROWSER_CREDENTIAL_PROVIDER=os
STEP_BROWSER_CREDENTIAL_REF=
# Optional local persistent browser profile. Keep under .step-ai/ so it stays local and gitignored.
STEP_BROWSER_PROFILE_DIR=.step-ai/browser-profile
