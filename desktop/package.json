{
  "name": "@step-cmu/desktop",
  "version": "0.5.13",
  "license": "MIT",
  "private": true,
  "description": "Local STeP employee workspace",
  "author": "STeP AI Working Group",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "start": "electron .",
    "test": "tsx --test test/*.test.ts",
    "test:installer": "node test/installer-upgrade-smoke.mjs",
    "qa:exports": "node scripts/export-qa.mjs",
    "test:electron": "node test/ux-audit-smoke.mjs && node test/i18n-smoke.mjs && node test/browser-loop-smoke.mjs && node test/browser-agent-smoke.mjs && node test/account-connect-smoke.mjs && node test/chat-smoke.mjs && node test/electron-smoke.mjs && node test/policy-smoke.mjs && node test/tool-loop-smoke.mjs && node test/context-memory-smoke.mjs && node test/phase4-smoke.mjs && node test/phase5-smoke.mjs && node test/phase6-smoke.mjs && node test/antigravity-smoke.mjs && node test/gemini-api-smoke.mjs && node test/provider-presets-smoke.mjs && node test/sidebar-smoke.mjs && node test/shared-profile-smoke.mjs && node test/view-switch-smoke.mjs && node test/learning-smoke.mjs && node test/default-model-smoke.mjs",
    "preview": "vite --host 127.0.0.1",
    "package": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && node scripts/package-windows.mjs",
    "dist:mac": "npm run build && electron-builder --publish never --mac dmg zip --arm64",
    "icon": "electron scripts/make-icon.cjs",
    "dist:mac:x64": "npm run build && node scripts/fetch-mac-x64-runtimes.mjs && electron-builder --publish never --mac dmg zip --x64",
    "bundle:ocr": "node scripts/bundle-ocr.mjs",
    "format": "prettier --write \"electron/**/*.{ts,cjs}\" \"src/**/*.{ts,tsx,css}\" \"test/**/*.{ts,mjs}\" \"eval/**/*.{ts,json}\" \"scripts/**/*.{mjs,cjs}\" build.mjs vite.config.ts",
    "format:check": "prettier --check \"electron/**/*.{ts,cjs}\" \"src/**/*.{ts,tsx,css}\" \"test/**/*.{ts,mjs}\" \"eval/**/*.{ts,json}\" \"scripts/**/*.{mjs,cjs}\" build.mjs vite.config.ts",
    "eval:golden": "tsx eval/golden.ts",
    "eval:features": "tsx eval/feature-matrix.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.284",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@github/copilot-sdk": "1.0.16",
    "@google/gemini-cli": "0.61.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@openai/codex": "0.158.0",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "docx": "^9.0.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "pptxgenjs": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "44.4.5",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "highlight.js": "^11.12.0",
    "js-yaml": "^4.3.2",
    "prettier": "3.9.9",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  },
  "build": {
    "asar": false,
    "appId": "th.ac.cmu.step.desktop",
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/iisara555/STeP-AI-Harness/releases/download/desktop-latest"
      }
    ],
    "productName": "STeP Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "harness",
        "filter": [
          "package.json",
          "src/**/*",
          "skills/**/*",
          "rules/**/*",
          "manifest/**/*",
          "docs/**/*",
          "!docs/staff-abbreviations.md"
        ]
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "../experiments/local-thai-ocr",
        "to": "ocr",
        "filter": [
          "**/*",
          "!.venv{,/**}",
          "!tests{,/**}",
          "!**/__pycache__{,/**}",
          "!output{,/**}",
          "!*.bat",
          "!*.command",
          "!.gitignore",
          "!.DS_Store"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "STeP-Desktop-Setup-${version}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "STeP Desktop",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "STeP-Desktop-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "STeP Desktop ${version}",
      "contents": [
        {
          "x": 140,
          "y": 190
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
