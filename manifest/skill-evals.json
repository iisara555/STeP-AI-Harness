{
  "version": 1,
  "description": "STeP Skill evaluation coverage baseline. Registration/routability is not the same as model-side usefulness.",
  "requiredDimensions": {
    "positive": "should trigger and produce the intended deliverable",
    "antiTrigger": "similar request that should not use this Skill",
    "collision": "request overlapping a neighboring Skill; Router must choose correctly",
    "missingSource": "when authoritative input is unavailable, expose the gap instead of inventing it"
  },
  "promotionPolicy": {
    "draftToPilot": [
      "manifest/router integrity",
      "local dependency validation",
      "positive eval",
      "anti-trigger eval",
      "collision eval",
      "source/authority mapping when relevant"
    ],
    "pilotToApproved": [
      "owner review",
      "usage evidence",
      "no unresolved critical safety issue",
      "record explicit approval evidence; approval role alone is insufficient"
    ]
  },
